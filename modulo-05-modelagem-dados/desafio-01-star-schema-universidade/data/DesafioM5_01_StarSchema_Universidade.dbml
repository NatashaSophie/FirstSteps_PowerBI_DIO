Table D_Professor {
  sk_professor int [pk, increment]
  id_professor int [not null, unique]
  Note: 'Dimensao Professor. sk_professor e a chave artificial; id_professor e a chave natural do modelo relacional.'
}

Table D_Departamento {
  sk_departamento int [pk, increment]
  id_departamento int [not null, unique]
  nome varchar(45)
  campus varchar(45)
  id_professor_coordenador int
  Note: 'Dimensao Departamento. Preserva o identificador original do professor coordenador como atributo, sem criar relacionamento direto com D_Professor.'
}

Table D_Disciplina {
  sk_disciplina int [pk, increment]
  id_disciplina int [not null, unique]
  Note: 'Dimensao Disciplina. Preserva o identificador original da disciplina. O relacionamento com o professor sera representado na tabela fato.'
}

Table D_Curso {
  sk_curso int [pk, increment]
  id_curso int [not null, unique]
  Note: 'Dimensao Curso. Preserva o identificador original do curso. A associacao com o departamento sera representada na tabela fato.'
}

Table D_Data {
  sk_data int [pk, increment]
  data_completa date [not null, unique]
  dia int [not null]
  mes int [not null]
  nome_mes varchar(20)
  trimestre int [not null]
  ano int [not null]
  semestre int [not null]
  Note: 'Dimensao temporal hipotetica. Representa a data de inicio da oferta da disciplina. Acrescentada para atender ao desafio de modelagem dimensional.'
}

Table F_Professor_Disciplina_Curso {
  sk_fato int [pk, increment]
  sk_professor int [not null]
  sk_departamento int [not null]
  sk_disciplina int [not null]
  sk_curso int [not null]
  sk_data int [not null]
  quantidade_vinculos int [not null, default: 1]
  Note: 'Tabela fato com granularidade professor-disciplina-curso-oferta academica. O departamento corresponde ao vinculo do professor. A data representa o inicio hipotetico da oferta. Cada registro contabiliza um vinculo.'
}

Ref: F_Professor_Disciplina_Curso.sk_professor > D_Professor.sk_professor
Ref: F_Professor_Disciplina_Curso.sk_departamento > D_Departamento.sk_departamento
Ref: F_Professor_Disciplina_Curso.sk_disciplina > D_Disciplina.sk_disciplina
Ref: F_Professor_Disciplina_Curso.sk_curso > D_Curso.sk_curso
Ref: F_Professor_Disciplina_Curso.sk_data > D_Data.sk_data
